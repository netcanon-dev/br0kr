# br0kr deployment config — copy to `.env` and fill in. The real `.env` is .gitignored
# (only this *.example template is committed), so secrets never enter the repo.
#
# `docker compose up` reads this file: it both interpolates ${VARS} into docker-compose.yml
# AND the values flow into the broker containers' environment. See docs/runbooks/docker-deploy.md.

# ── Ledger (Postgres) credentials ───────────────────────────────────────────────
# Used by the bundled pg-primary/pg-standby containers. POSTGRES_USER/DB also appear in
# the PGCONN below; if you change them, change PGCONN to match.
POSTGRES_USER=broker
POSTGRES_DB=broker
PGPASSWORD=change-me-to-a-strong-password

# ── Ledger DSN the broker connects with ─────────────────────────────────────────
# DEFAULT = the bundled HA pair: libpq tries BOTH hosts and target_session_attrs=read-write
# selects the current PRIMARY, so after a failover a fresh connection re-homes onto the
# promoted node with NO code change (br0kr/db.py). The password here MUST match PGPASSWORD.
#
# Using an EXTERNAL/managed Postgres instead? Set PGCONN to your own DSN and start only the broker
# services with --no-deps (so the bundled pg-* aren't pulled in) — see docs/runbooks/docker-deploy.md §6.
PGCONN=host=pg-primary,pg-standby port=5432 dbname=broker user=broker password=change-me-to-a-strong-password target_session_attrs=read-write

# ── Reconciler daemon tunables (br0kr/daemon.py) ────────────────────────────────
# NOTE: REAP_GRACE / SWEEP_EVERY / PROVISION_LIMIT / PROMOTE_LIMIT / BUILD_LIMIT / MIGRATE_LIMIT / QUEUE_MAX
# / SWEEP_DRY_RUN can ALSO be overridden at runtime (no restart) from the operator Settings page — the
# ledger override wins over the env var here (COALESCE ledger→env→default; see br0kr/settings.py). TICK/
# RELOAD cadence + bind ports stay env-only.
BR0KR_TICK_SECONDS=5
BR0KR_REAP_GRACE=30
BR0KR_SWEEP_EVERY=12
BR0KR_PROVISION_LIMIT=8
BR0KR_PROMOTE_LIMIT=16         # max queued (PENDING) leases the promoter admits per tick
BR0KR_QUEUE_MAX=1000           # global cap on the admission queue depth (gateway refuses queue=true past it)
BR0KR_RELOAD_EVERY=60          # rebuild the node registry from the ledger every N ticks (0 disables; SIGHUP forces one)
BR0KR_HEALTH_PORT=9090         # daemon health/metrics HTTP port: /healthz /readyz /metrics (0 disables)
# BR0KR_HEALTH_HOST=0.0.0.0    # daemon health/metrics bind host (default 0.0.0.0 — reachable in-cluster)
# BR0KR_VM_DISK=local-zfs:8     # uncomment to provision disk-backed guests (else config-only shells)
# BR0KR_VM_TEMPLATE=9000        # default OS-template vmid to CLONE when a lease picks no catalog template
#                               #   (blank = provision a config-only fenced shell, no guest disk). Agents can
#                               #   always pass template_id per-lease regardless of this default.
# BR0KR_VM_FULL_CLONE=1         # 1 = full clone (default); 0 = faster/lighter LINKED clones (clone-capable storage)
# BR0KR_VM_CLONE_STORAGE=       # target storage for the clone's disk (blank = the template's own storage — the
#                               #   supported way to force boot disks onto a specific pool is to build the
#                               #   template's disk THERE, or set this to that pool)
# BR0KR_CI_USER=br0kr           # default cloud-init login user when a lease doesn't pass ci_user
# BR0KR_IP_DISCOVER_LIMIT=16    # max ACTIVE cloud-init leases polled for a guest IP per tick
# NOTE: the five BR0KR_VM_*/CI_USER/IP_DISCOVER_LIMIT knobs above are passed through to the daemon by
# docker-compose.yml (daemon.environment). A .env entry for any env var NOT listed there is a silent no-op.
# BR0KR_SWEEP_DRY_RUN=1         # uncomment to make the orphan sweep log-only (destroys nothing)
# BR0KR_CLONE_CONTENT_ENFORCEMENT=1  # 1 = the placement gate refuses a clone whose TARGET pool is not
#                               #   `images`-capable (storage_not_capable) BEFORE PVE fails the disk-create; 0/unset
#                               #   = OFF (default, byte-identical to the pre-0042 gate). FAIL-CLOSED when ON — an
#                               #   UNDECLARED pool refuses too — so declare every bound pool's content
#                               #   (admin.set_storage_content) BEFORE enabling, or every clone onto an undeclared
#                               #   pool refuses. This env line ONLY seeds the DAEMON's recheck (wired in
#                               #   docker-compose.yml); admit() runs in the GATEWAY, so to enable enforcement
#                               #   FLEET-WIDE set the SHARED operator_setting via the dashboard Settings ledger
#                               #   (all processes read it, no container drift — the §3.5 rule, 0042/PR-D).
# BR0KR_BUILD_LIMIT=0           # operator template BUILDS (download→import→templatize) actuated per tick — 0 =
#                               #   DISABLED (default; the dashboard queues a build but the daemon never runs it
#                               #   until >0). REQUIRED for rebuild_source replication (which needs a BUILT, i.e.
#                               #   source-provenanced, template). Wired on the DAEMON container; restart to change.
# BR0KR_BUILD_STALE_SECONDS=3600 # reclaim a build with no progress for this long (a leader died mid-build).
# BR0KR_BUILD_CORES=2           # cores of the transient build VM (sizes the resulting template).
# BR0KR_BUILD_MEMORY_MB=2048    # memory (MB) of the transient build VM.
# BR0KR_MIGRATE_LIMIT=0         # cross-cluster migrations actuated per tick — 0 = DISABLED (the default; a
#                               #   requested migrate stays REQUESTED until >0 AND the source cluster has PDM)
# BR0KR_REPLICATION_MECHANISMS=clone_shared   # allowlist (comma list) of enabled replication mechanisms — the
#                               #   ENV SEED for the SHARED operator_setting (migration 0034); prefer the
#                               #   dashboard Settings ledger override so ALL processes agree. Default (and the
#                               #   only implemented mechanism) is clone_shared. Read by the GATEWAY on a
#                               #   replicate request, so a plain-env value must be on the GATEWAY container.
# BR0KR_REPLICATE_LIMIT=0       # replication DATA PLANE: clone_shared copies actuated per tick — 0 = DISABLED
#                               #   (default). >0 opts the LEADER daemon into advancing copies AND publishes
#                               #   operator_setting.replication_enabled so the request surface is honest. Must be
#                               #   on the DAEMON container (wired in docker-compose.yml); ENV-only, restart to change.
# BR0KR_REPL_STALE_SECONDS=7200 # replication DATA PLANE: stranded-copy reclaim cutoff + reservation TTL (2×).

# ── Logging (br0kr/logging_setup.py) ────────────────────────────────────────────
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR. The reconciler DAEMON also exposes log_level as
#                              #   a runtime HOT-KNOB on the operator Settings page — a dashboard override wins
#                              #   over this env and applies without a restart (migration 0022); the gateway +
#                              #   dashboard read this env only at startup.
# LOG_FORMAT=json              # 'json' for structured log lines; anything else = human-readable text

# ── Audit-trail retention (br0kr/audit.py + daemon, migration 0024) ──────────────
# BR0KR_AUDIT_RETENTION_DAYS=0  # prune operator_audit rows older than N days. 0 = OFF (keep forever — the
#                              #   default; enabling the one sanctioned delete on the append-only trail is a
#                              #   deliberate opt-in). Also a runtime HOT-KNOB (audit_retention_days) on the
#                              #   operator Settings page — a dashboard override wins over this env and applies
#                              #   without a restart. Daemon-only (the prune runs in the reconcile tick).

# ── Reachability-discovery cadence (br0kr/placement.py + daemon, migration 0043) ──
# BR0KR_DISCOVERY_INTERVAL_SECONDS=0  # run the READ-ONLY discover_reachability drift report every N seconds and
#                              #   LOG the storage/bridge drift + publish the discovery_drift gauge, so drift is
#                              #   seen on a schedule without hand-running the MCP verb. 0 = OFF (default — no
#                              #   periodic report, no extra PVE traffic). REPORT-ONLY: it WRITES NOTHING to
#                              #   declarations (a future auto_confirm on any discovery cadence is FORBIDDEN,
#                              #   design §11) — only the operator confirm verbs mutate. Also a runtime HOT-KNOB
#                              #   (discovery_interval_seconds) on the operator Settings page — a dashboard
#                              #   override wins over this env, no restart. Daemon-only (runs in the reconcile tick).

# ── Gateway (agent-facing MCP server, br0kr/mcp_server.py) ──────────────────────
# streamable-http exposes the broker as a shared HTTP MCP service on GATEWAY_PORT.
GATEWAY_PORT=8080
BR0KR_MCP_TRANSPORT=streamable-http

# ── Dashboard (web view, br0kr/dashboard.py — OPT-IN profile) ────────────────────
# Enable with `docker compose --profile dashboard up -d dashboard`. READS are unauthenticated plain HTTP
# — keep it on a trusted network (SECURITY.md C3); they expose only capacity counts / queue state, never a
# secret. Leaving BR0KR_DASHBOARD_TOKEN unset = READ-ONLY. Set a strong secret to enable the token-gated
# operator actions (cancel a lease / edit a quota); it is a single shared token over plain HTTP, so still
# keep the surface trusted-net / behind TLS.
# To harden a less-trusted network, ALSO set BR0KR_DASHBOARD_READ_TOKEN to require a bearer on the inventory
# reads (unset = reads open, the default); the operator token above also satisfies it, so hand a read-only
# viewer the read token while an operator uses one credential.
DASHBOARD_PORT=8051
# BR0KR_DASHBOARD_TOKEN=change-me-to-a-long-random-secret
# BR0KR_DASHBOARD_READ_TOKEN=change-me-to-a-different-long-random-secret

# ── Built-in TLS termination (OPTIONAL — Caddy; see docs/runbooks/docker-deploy.md §10) ──────────
# The deploy gate: by DEFAULT the gateway/dashboard are PLAIN HTTP (keep on a trusted network, or put your
# OWN reverse proxy / TLS terminator in front). To use the built-in Caddy instead, enable it via the
# version-gated wrapper:  bash scripts/tls-up.sh up -d   (it refuses Docker Compose < 2.24, where the
# port un-publish would silently no-op and leak the plain port). Caddy then terminates TLS and the plain
# gateway/dashboard ports are UN-published (only Caddy is exposed).
# DEFAULT cert = Caddy's internal self-signed CA (offline, no domain). For a PUBLIC cert, set BR0KR_TLS_SITE
# to a real domain AND BR0KR_TLS_ISSUER to your ACME email.
# BR0KR_TLS_SITE=localhost              # the gateway's TLS site: your host's LAN name/IP, or a public domain
#                                       #   A BARE IP works: a browser sends no SNI to an IP (RFC 6066), so
#                                       #   Caddy's default_sni serves this site's cert to the no-SNI ClientHello.
# BR0KR_TLS_DASHBOARD_SITE=localhost:8443   # the dashboard's TLS site (only with --profile dashboard). For LAN
#                                       #   access set <ip>:8443 (the default localhost:8443 matches only a
#                                       #   localhost Host), then browse https://<ip>:8443 (accept the internal CA).
# BR0KR_TLS_ISSUER=internal             # 'internal' = self-signed CA; set to your ACME email for Let's Encrypt
# TLS_GATEWAY_PORT=443                  # host port for the gateway over TLS
# TLS_DASHBOARD_PORT=8443               # host port for the dashboard over TLS

# ── OAuth 2.1 connector shim (OPTIONAL — br0kr/oauth.py; needs TLS; see docs/runbooks/oauth-connector.md) ──
# Lets OAuth-only MCP hosts (Claude Desktop / claude.ai custom connectors) connect — they can't paste a
# bearer, so the shim runs the OAuth flow and MINTS a project api_token after an in-browser "paste a project
# token" consent. Enable it (requires TLS):  bash scripts/tls-up.sh --profile oauth up -d
# The issuer (every discovery URL) defaults to https://<BR0KR_TLS_SITE>; behind a tunnel, BR0KR_PUBLIC_URL
# below OVERRIDES it (br0kr/oauth.py issuer()). Set BR0KR_TLS_SITE above and you're done for a direct LAN host.
# BR0KR_OAUTH_CODE_TTL=120              # authorization-code lifetime (seconds); short by design (single-use)
# BR0KR_OAUTH_TOKEN_TTL_DAYS=30         # lifetime of the MINTED access token (a project api_token); no refresh

# ── Public reachability via a reverse proxy / tunnel (OPTIONAL — see docs/runbooks/public-tunnel.md) ──────
# WHY: an OAuth-only connector (Claude Desktop) runs its OAuth discovery from Anthropic's CLOUD, which cannot
# reach a br0kr on a PRIVATE LAN IP — so the connector needs a stable PUBLIC https URL. A tunnel provides one
# without opening an inbound port. This decouples the PUBLIC hostname (what discovery / WWW-Authenticate
# advertise) from the internal Caddy origin (host-agnostic :8081), so the tunnel's public host != the origin.
# BR0KR_PUBLIC_URL=https://br0kr.example.com   # the tunnel's public https URL. Set this AND enable the tunnel
#                                              #   profile; unset = direct-TLS-only (LAN). No trailing slash.
# TUNNEL_TOKEN=                          # Cloudflare NAMED-tunnel connector token (Zero Trust dashboard →
#                                        #   create a tunnel → route the public hostname to service
#                                        #   http://caddy:8081 → copy the token here). Required for --profile
#                                        #   tunnel. Enable with:
#                                        #     bash scripts/tls-up.sh --profile oauth --profile tunnel up -d

# ── Per-cluster PVE API token secret(s) ─────────────────────────────────────────
# Each `cluster` row in the ledger names the env var holding its PVE token secret
# (cluster.token_secret_env) — the secret is NEVER stored in the ledger, only referenced by
# name. Set the matching var(s) here. PVE_TOKEN_SECRET is the conventional default; if you run
# multiple clusters with distinct secret-env names, add a line per cluster AND pass it through
# in docker-compose.yml's `daemon.environment`.
PVE_TOKEN_SECRET=

# ── Stretched DR standby (OPTIONAL — see docs/runbooks/docker-deploy.md §9) ──────
# Only needed if you run a remote standby on another host/segment over the mesh, layered via
# docker-compose.primary-remote.yml. Setting REPLICATION_PASSWORD switches the primary into DR mode
# (authenticated TLS replication, no trust line — don't run the bundled pg-standby alongside it).
# REPLICATION_PASSWORD=change-me-strong-replication-password   # must match the remote .env.standby
# REPLICATION_CIDR=100.64.0.0/10        # your mesh's CIDR (narrow it; default 0.0.0.0/0 is auth+TLS-gated)
# PRIMARY_BIND=100.x.y.z                # this host's MESH interface IP (never 0.0.0.0)
# PRIMARY_PUBLISH_PORT=5432             # the host port the standby connects to over the mesh
