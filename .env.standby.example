# Stretched DR standby config — copy to `.env.standby` (gitignored) on the REMOTE host. Run:
#   docker compose -f docker-compose.standby.yml --env-file .env.standby up -d
# See docs/runbooks/docker-deploy.md §9.

# The primary's address ON THE MESH (Tailscale/Headscale IP or name). MUST exactly match the CN/SAN
# you passed to docker/gen-replication-certs.sh on the primary — verify-full checks it.
PRIMARY_HOST=100.x.y.z
PRIMARY_PORT=5432

# Replication identity. Keep REPLICATION_USER = replicator: the primary hardcodes that role + its HBA
# rule (docker/pg-primary-init.sh) — changing it here makes the clone fail "no pg_hba.conf entry for
# role …". REPLICATION_PASSWORD MUST match the primary's REPLICATION_PASSWORD (docker-compose.primary-
# remote.yml); any characters are fine (the standby holds it in an escaped passfile).
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change-me-to-match-the-primary

# TLS posture. verify-full = encrypt AND authenticate the primary against the pinned CA (./certs/ca.crt,
# copied from the primary host). Don't weaken below verify-ca without good reason.
REPLICATION_SSLMODE=verify-full

# The physical replication slot the primary created for this standby (see pg-primary-init.sh DR mode).
REPLICATION_SLOT=br0kr_standby_dr
